                    "targetname": "s3_track_start_68",
                    "inputname": "AddOutPut",
                    "overrideparam": "OnPass>command>Command>say ** ...思考同期を開始, 記憶の連鎖を共有... **>6.0>1",
                    "delay": 0.0,
                    "timestofire": -1
                },

                {
                    "outputname": "OnCase01",
                    "targetname": "s3_track_start_68",
                    "inputname": "AddOutPut",
                    "overrideparam": "OnPass>command>Command>say ** バートリー **>8.0>1",
                    "delay": 0.0,
