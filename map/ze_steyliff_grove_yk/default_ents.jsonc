{
	"modify": 
    [
        {
            "match":
            {
                "classname": "logic_auto"
            },
            "delete": 
            {
                "io":
                [
					// readjusting the delay to apply AddOutPut +0.1 sec
					{
                        "outputname": "OnMapSpawn",
						"targetname": "[PR#]Stage_Math",
                        "inputname": "GetValue",
                        "delay": 0.0,
                        "timestofire": 1
                    },
                    // remove message output
                    {
                        "outputname": "OnMapSpawn",
						"targetname": "[PR#]Console",
                        "inputname": "Command",
                        "overrideparam": "say < 后续制作：runa >",
                        "delay": 8.0,
                        "timestofire": -1
                    },

                    {
                        "outputname": "OnMapSpawn",
						"targetname": "[PR#]Console",
                        "inputname": "Command",
                        "overrideparam": "say > 幻影剑目前可能存在bug，如果有遇到穿墙之类的情况，请自觉返回地图。",
                        "delay": 9.0,
                        "timestofire": 1
                    },

                    {
                        "outputname": "OnMapSpawn",
						"targetname": "[PR#]Console",
                        "inputname": "Command",
                        "overrideparam": "> 无法返回地图请自觉处死自己",
                        "delay": 10.0,
                        "timestofire": 1
                    },

                    {
                        "outputname": "OnMapSpawn",
						"targetname": "[PR#]Console",
                        "inputname": "Command",
                        "overrideparam": "say > 某些地方存在能用幻影剑提前触发的情况，也不要提前触发",
                        "delay": 11.0,
                        "timestofire": 1
                    },

                    {
                        "outputname": "OnMapSpawn",
						"targetname": "[PR#]Console",
                        "inputname": "Command",
                        "overrideparam": "say > no卖人",
                        "delay": 12.0,
                        "timestofire": 1
                    }
                ]
            },
            "insert":
            {
                "io":
                [
					{
                        "outputname": "OnMapSpawn",
						"targetname": "Stage_Math",
                        "inputname": "GetValue",
                        "delay": 0.1,
                        "timestofire": 1
                    },

					{
                        "outputname": "OnMapSpawn",
						"targetname": "language_case",
                        "inputname": "InValue",
                        "overrideparam": "en", // please type language serial code here
                        "delay": 0.0,
                        "timestofire": -1
                    },
                    /*
					{
                        "outputname": "OnMapSpawn",
						"targetname": "lyric_toggle",
                        "inputname": "SetValueTest",
                        "overrideparam": "1", // Enable:1, Disable:0
                        "delay": 0.0,
                        "timestofire": -1
                    },
                    */
                    // stripper update log
                    {
                        "outputname": "OnMapSpawn",
						"targetname": "ServerCommand",
                        "inputname": "Command",
                        "overrideparam": "say language translation stripper 26.10.30 by 兎RB",
                        "delay": 13.0,
                        "timestofire": -1
                    }
                ]
            }
        }
    ],
