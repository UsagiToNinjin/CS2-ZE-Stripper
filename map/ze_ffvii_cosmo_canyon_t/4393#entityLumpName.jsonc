{
	"modify":
    [
		// convert RunScriptCode(lua script), AddOutput to Keyvalue format
		// convert inputname Display(game_text) to Enable/Disable(point_worldtext)
        {
		    "match":
            {
				"targetname": "[PR#]Item_Z_Confuse_knife",
				"classname": "weapon_knife"
            },
			"delete": 
            {
                "io":
                [
					{
						"outputname": "OnPlayerPickup",
						"targetname": "!activator",
						"inputname": "AddOutput",
						"overrideparam": "health 50000",
						"delay": 0.0,
						"timestofire": 1
					},

					{
						"outputname": "OnPlayerPickup",
						"targetname": "[PR#]Item_Z_Confuse_Gametext",
						"inputname": "Display",
						"delay": 0.5,
						"timestofire": -1
					}
				]
			},
			"insert": 
            {
                "io":
                [
					{
						"outputname": "OnPlayerPickup",
						"targetname": "!activator",
						"inputname": "KeyValue",
						"overrideparam": "health 50000",
						"delay": 0.0,
						"timestofire": 1
					},

					{
						"outputname": "OnPlayerPickup",
						"targetname": "Item_Z_Confuse_Gametext",
						"inputname": "Enable",
						"delay": 0.5,
						"timestofire": -1
					},

					{
						"outputname": "OnPlayerPickup",
						"targetname": "Item_Z_Confuse_Gametext",
						"inputname": "Disable",
						"delay": 7.0,
						"timestofire": -1
					}
				]
			}
		},
		// convert inputname Trigger(logic_relay) to Use(game_player_equip) 
		{
		    "match":
            {
				"targetname": "[PR#]Item_Z_Confuse_Stripper",
				"classname": "trigger_multiple"
            },
			"delete": 
            {
                "io":
                [
					{
						"outputname": "OnStartTouch",
						"targetname": "[PR#]Strip_Knife",
						"inputname": "Trigger",
						"delay": 0.0,
						"timestofire": -1
					}
				]
			},
			"insert": 
            {
                "io":
                [
					{
						"outputname": "OnStartTouch",
						"targetname": "Strip_Knife",
						"inputname": "Use",
						"delay": 0.0,
						"timestofire": 1
					}
				]
			}
		},
		// convert game_text to point_worldtext, since game_text is unsupported in CS2
		// why does the item information in game_text differ from the actual values?
		// cooldown 70sec >> 75sec, duration 7sec >> 5sec
		{
		    "match":
            {
				"targetname": "[PR#]Item_Z_Confuse_Gametext",
				"classname": "game_text"
            },
			"replace": 
            {
                "classname": "point_worldtext",
                "origin": "40 25 50",
                "angles": "0 -90 90",
			    "scales": "1 1 1",
                "parentname": "Item_Z_Confuse_knife",
			    "depth_render_offset": "0.125",
			    "reorient_mode": "0",
                "justify_vertical": "1",
			    "justify_horizontal": "0",
                "font_name": "Arial Black",
                "font_size": "15",
                "world_units_per_pixel": "0.25",
                "color": "255 128 192",
                "fullbright": "1",
                "enabled": "0",
                "message": "Item> Zombie confuse\nEffect> Creates a magic that block\nnearby humans view\nDuration> 5 seconds\nCooldown> 75 seconds",
			    "fademaxdist": "0",
		        "fademindist": "-1",
                "rendercolor": "255 255 255",
                "renderamt": "255",
                "rendermode": "kRenderNormal",
                "renderfx": "kRenderFxNone"
			}
		}
	]
