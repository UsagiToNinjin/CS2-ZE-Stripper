// stripper by 兎RB 26.07.28
// map ze_ffvii_cosmo_canyon_t
// workshop id 3310260547
{
	"modify":
    [
		// convert RunScriptCode(lua script), AddOutput to Keyvalue format
        {
		    "match":
            {
				"targetname": "/Item_Heal_(Trigger|Trigger_Fix)/",
				"classname": "trigger_hurt"
            },
			"delete": 
            {
                "io":
                [
					{
						"outputname": "OnStartTouch",
						"targetname": "!activator",
						"inputname": "AddOutput",
						"overrideparam": "max_health 200",
						"delay": 0.0,
						"timestofire": -1
					},

					{
						"outputname": "OnStartTouch",
						"targetname": "!activator",
						"inputname": "RunScriptCode",
						"overrideparam": "thisEntity:SetMaxHealth(200)",
						"delay": 0.0,
						"timestofire": -1
					}
				]
			},
			"insert": 
            {
                "io":
                [
					{
						"outputname": "OnStartTouch",
						"targetname": "!activator",
						"inputname": "KeyValue",
						"overrideparam": "max_health 200",
						"delay": 0.0,
						"timestofire": -1
					}
				]
			}
		},
		// convert game_text to point_worldtext, since game_text is unsupported in CS2
		{
		    "match":
            {
				"targetname": "[PR#]Item_Heal_Gametext",
				"classname": "game_text"
            },
			"replace": 
            {
                "classname": "point_worldtext",
                "origin": "40 35 50",
                "angles": "0 -90 90",
			    "scales": "1 1 1",
                "parentname": "Weapon_Heal",
			    "depth_render_offset": "0.125",
			    "reorient_mode": "0",
                "justify_vertical": "1",
			    "justify_horizontal": "0",
                "font_name": "Arial Black",
                "font_size": "15",
                "world_units_per_pixel": "0.25",
                "color": "255 255 255",
                "fullbright": "1",
                "enabled": "0",
                "message": "Item> Heal\nEffect> Gives 200 HP and immunity to zombies\nDuration> 7 seconds\nCooldown> 60 seconds",
			    "fademaxdist": "0",
		        "fademindist": "-1",
                "rendercolor": "255 255 255",
                "renderamt": "255",
                "rendermode": "kRenderNormal",
                "renderfx": "kRenderFxNone"
			}
		},
		// convert inputname Display(game_text) to Enable/Disable(point_worldtext)
		{
		    "match":
            {
				"targetname": "[PR#]Weapon_Heal",
				"classname": "weapon_elite"
            },
			"delete": 
            {
                "io":
                [
					{
						"outputname": "OnPlayerPickup",
						"targetname": "[PR#]Item_Heal_Gametext",
						"inputname": "Display",
						"delay": 0.5,
						"timestofire": -1
					}
				]
			},
			"insert": 
            {
                "io":
                [
					{
						"outputname": "OnPlayerPickup",
						"targetname": "Item_Heal_Gametext",
						"inputname": "Enable",
						"delay": 0.5,
						"timestofire": -1
					},

					{
						"outputname": "OnPlayerPickup",
						"targetname": "Item_Heal_Gametext",
						"inputname": "Disable",
						"delay": 4.0,
						"timestofire": -1
					}
				]
			}
		}
	]
}
