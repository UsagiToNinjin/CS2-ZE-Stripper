						"timestofire": -1
					},

					{
						"outputname": "OnPlayerPickup",
						"targetname": "[PR#]Potion_Gametext",
						"inputname": "Display",
						"delay": 0.5,
						"timestofire": -1
					}
				]
			},
			"insert": 
            {
