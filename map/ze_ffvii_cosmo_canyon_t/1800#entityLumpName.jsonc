					{
						"outputname": "OnPlayerPickup",
						"targetname": "Potion_Gametext",
						"inputname": "Disable",
						"delay": 4.0,
						"timestofire": -1
					}
				]
			}
		},
		// convert game_text to point_worldtext, since game_text is unsupported in CS2
