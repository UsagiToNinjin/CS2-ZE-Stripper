// if find mistranslation tell me https://steamcommunity.com/profiles/76561198343767968/
{
	"modify": // remove message output, convert env_hudhint to point_worldtext
    [
        {
            "match":
            {
                "targetname": "[PR#]Item_Red_Mage_Elite"
            },
            "delete":
            {
                "io":
                [
					{
                        "outputname": "OnPlayerPickup",
						"targetname": "[PR#]ServerCommand",
                        "inputname": "Command",
                        "overrideparam": "say ** 一位赤魔法师加入了队伍 **",
                        "delay": 0.0,
                        "timestofire": 1
                    }
				]
			}
        },

        {    
            "match":
            {
                "targetname": "[PR#]Item_Red_Mage_Text",
                "classname": "env_hudhint"
            },
            "replace":
            {
                "classname": "point_worldtext",
                "origin": "40 0 0",
                "angles": "0 -90 90",
			    "scales": "1 1 1",
                "parentname": "Item_Red_Mage_Elite",
			    "depth_render_offset": "0.125",
			    "reorient_mode": "0",
                "justify_vertical": "1",
			    "justify_horizontal": "1",
                "font_name": "Arial Black",
                "font_size": "15",
                "world_units_per_pixel": "0.25",
                "color": "242 171 48",
                "fullbright": "1",
                "enabled": "0",
                "message": "",
			    "fademaxdist": "0",
		        "fademindist": "-1",
                "rendercolor": "255 255 255",
                "renderamt": "255",
                "rendermode": "kRenderNormal",
                "renderfx": "kRenderFxNone"
            },
            "delete":
            {
                "io":
                [
                    {
                        "outputname": "OnUser1",
						"targetname": "!self",
                        "inputname": "SetMessage",
                        "overrideparam": "积攒魔元，释放强力技能吧",
                        "delay": 7.5,
                        "timestofire": 1
                    },

                    {
                        "inputname": "ShowHudHint"
                    }
				]
			},
            "insert":
            {
                "io":
                [
					{
                        "outputname": "OnUser1",
						"targetname": "!self",
                        "inputname": "Enable",
                        "delay": 0.0,
                        "timestofire": 1
                    },

                    {
                        "outputname": "OnUser1",
						"targetname": "!self",
                        "inputname": "Disable",
                        "delay": 11.5,
                        "timestofire": 1
                    }
				]
			}
		},

        {
            "match":
            {
                "targetname": "[PR#]Item_Red_Mage_Ulti_Hint_Branch"
            },
            "delete":
            {
                "io":
                [
					{
                        "outputname": "OnTrue",
						"targetname": "[PR#]Item_Red_Mage_Text",
                        "inputname": "SetMessage",
                        "overrideparam": "按下WASD切换技能，当前技能：Holy",
                        "delay": 0.0,
                        "timestofire": -1
                    },

                    {
                        "outputname": "OnFalse",
						"targetname": "[PR#]Item_Red_Mage_Text",
                        "inputname": "SetMessage",
                        "overrideparam": "按下WASD切换技能，当前技能：Flare",
                        "delay": 0.0,
                        "timestofire": -1
                    },

                    {
                        "inputname": "ShowHudHint"
                    }
				]
			},
            "insert":
            {
                "io":
                [
					{
                        "outputname": "OnTrue",
						"targetname": "Item_Red_Mage_Text",
                        "inputname": "Enable",
                        "delay": 0.0,
                        "timestofire": -1
                    },

                    {
                        "outputname": "OnTrue",
						"targetname": "Item_Red_Mage_Text",
                        "inputname": "Disable",
                        "delay": 4.0,
                        "timestofire": -1
                    },

                    {
                        "outputname": "OnFalse",
						"targetname": "Item_Red_Mage_Text",
                        "inputname": "Enable",
                        "delay": 0.0,
                        "timestofire": -1
                    },

                    {
                        "outputname": "OnFalse",
						"targetname": "Item_Red_Mage_Text",
                        "inputname": "Disable",
                        "delay": 4.0,
                        "timestofire": -1
                    }
				]
			}
        }
    ]
}
