{
    "filter": // remove unnecessary entities
    [
        {
            "targetname": "/Knife_Invis_(Finder|Finder_Filter|Knife_Filter)/"
        }
    ],
	"modify":
    [
        // convert RunScriptCode(lua script) to Keyvalue format
        {
            "match":
            {
                "targetname": "[PR#]Knife_Invis_Knife",
                "classname": "weapon_knife"
            },
            "delete":
            {
                "io":
                [
					{
                        "outputname": "OnPlayerPickup",
						"targetname": "!activator",
                        "inputname": "RunScriptCode",
                        "overrideparam": "thisEntity:SetMaxHealth(50000)",
                        "delay": 0.0,
                        "timestofire": -1
                    }
				]
			},
            "insert":
            {
                "io":
                [
					{
                        "outputname": "OnPlayerPickup",
						"targetname": "!activator",
                        "inputname": "KeyValue",
                        "overrideparam": "max_health 50000",
                        "delay": 0.0,
                        "timestofire": -1
                    }
				]
			}
		},
        // convert inputname Trigger(logic_relay) to Use(game_player_equip)
        {
            "match":
            {
                "targetname": "[PR#]Knife_Invis_Stripper",
                "classname": "trigger_once"
            },
            "delete":
            {
                "io":
                [
					{
                        "outputname": "OnStartTouch",
						"targetname": "[PR#]Strip_Knife",
                        "inputname": "Trigger",
                        "delay": 0.0,
                        "timestofire": -1
                    }
				]
			},
            "insert":
            {
                "io":
                [
					{
                        "outputname": "OnStartTouch",
						"targetname": "Strip_Knife",
                        "inputname": "Use",
                        "delay": 0.0,
                        "timestofire": 1
                    }
				]
			}
		}
	]
}