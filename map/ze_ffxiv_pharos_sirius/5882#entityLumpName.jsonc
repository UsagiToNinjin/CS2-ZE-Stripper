// + convert lua script L30~53
// + fix bug L55~88
{
	"modify":
    [
        // remove message output
        // convert RunScriptCode(lua script) to Keyvalue format
        {
            "match":
            {
                "targetname": "[PR#]Magic_Devour_WP",
                "classname": "weapon_knife"
            },
            "delete":
            {
                "io":
                [
					{
                        "outputname": "OnPlayerPickup",
						"targetname": "[PR#]Server",
                        "inputname": "Command",
                        "overrideparam": "say > 一名玩家学会了吞噬魔法",
                        "delay": 0.0,
                        "timestofire": 1
                    },

                    {
                        "outputname": "OnPlayerPickup",
						"targetname": "!activator",
                        "inputname": "RunScriptCode",
                        "overrideparam": "thisEntity:SetMaxHealth(100000)",
                        "delay": 0.0,
                        "timestofire": -1
                    }
				]
			},
            "insert":
            {
                "io":
                [
                    {
                        "outputname": "OnPlayerPickup",
						"targetname": "!activator",
                        "inputname": "KeyValue",
                        "overrideparam": "max_health 100000",
                        "delay": 0.0,
                        "timestofire": -1
                    }
				]
			}
		},
        // convert inputname Trigger(logic_relay) to Use(game_player_equip)
        {
		    "match":
            {
				"targetname": "[PR#]Magic_Devour_Strip",
				"classname": "trigger_multiple"
            },
			"delete": 
            {
                "io":
                [
					{
						"outputname": "OnTrigger",
						"targetname": "[PR#]Strip_Knife",
						"inputname": "Trigger",
						"delay": 0.0,
						"timestofire": -1
					}
				]
			},
			"insert": 
            {
                "io":
                [
					{
						"outputname": "OnTrigger",
						"targetname": "Strip_Knife",
						"inputname": "Use",
						"delay": 0.0,
						"timestofire": -1
					}
				]
			}		
		}
	]
}