// stripper by 兎RB 26.10.01
// map ze_deadcore_r
// workshop id 3331345627
{
    "filter": // remove unnecessary entities
    [
        {
            "targetname": "/stage_(abc|ab|ac|bc)_(case|relay)/",
            "classname": "/logic_(case|relay)/"
        },

        {
            "targetname": "[PR#]extra_case",
            "classname": "logic_case"
        }
    ],
	"modify": 
    [
        // add potal touch sound effect
        {
            "match":
            {
                "targetname": "/[a-d]_t[1-3]|c_t4/",
                "classname": "/trigger_(teleport|multiple)/"
            },
			"insert":
            {
                "io":
                [
					{
                        "outputname": "OnStartTouch",
				        "targetname": "music_potal_case",
                        "inputname": "PickRandom",
                        "delay": 0.0,
                        "timestofire": -1
                    }
                    /* If point_clientcommand does not work, use the script as an alternative
                    {
                        "outputname": "OnStartTouch",
				        "targetname": "map_brush",
                        "inputname": "RunScriptInput",
                        "overrideparam": "PlayBGM",
                        "delay": 0.0,
                        "timestofire": -1
                    }
                    */
				]
			}
		},
        // change logic_case "InValue" from float to int after the 26.09.22 update
        {
            "match":
            {
                "classname": "logic_case",
                "case01": "1"
            },
			"replace":
            {
                "case01": "1.0",
                "case02": "2.0",
                "case03": "3.0",
                "case04": "4.0",
                "case05": "5.0",
                "case06": "6.0",
                "case07": "7.0",
                "case08": "8.0",
                "case09": "9.0",
                "case10": "10.0",
                "case11": "11.0",
                "case12": "12.0",
                "case13": "13.0",
                "case14": "14.0",
                "case15": "15.0"
			}
		},
        // remove the item when stage B mini-game starts
        {
            "match":
            {
                "targetname": "[PR#]b_boss_counter1",
                "classname": "math_counter"
            },
			"insert":
            {
                "io":
                [
					{
                        "outputname": "OnHitMin",
				        "targetname": "cannon1_charge1",
                        "inputname": "Kill",
                        "delay": 77.0,
                        "timestofire": -1
                    },

                    {
                        "outputname": "OnHitMin",
				        "targetname": "cannon2_charge1",
                        "inputname": "Kill",
                        "delay": 77.0,
                        "timestofire": -1
                    },

                    {
                        "outputname": "OnHitMin",
				        "targetname": "cannon3_charge1",
                        "inputname": "Kill",
                        "delay": 77.0,
                        "timestofire": -1
                    },

                    {
                        "outputname": "OnHitMin",
				        "targetname": "cannon1_part*",
                        "inputname": "Kill",
                        "delay": 77.0,
                        "timestofire": -1
                    },

                    {
                        "outputname": "OnHitMin",
				        "targetname": "cannon2_part*",
                        "inputname": "Kill",
                        "delay": 77.0,
                        "timestofire": -1
                    },

                    {
                        "outputname": "OnHitMin",
				        "targetname": "cannon3_part*",
                        "inputname": "Kill",
                        "delay": 77.0,
                        "timestofire": -1
                    },

                    {
                        "outputname": "OnHitMin",
				        "targetname": "cannon1_button",
                        "inputname": "Kill",
                        "delay": 77.0,
                        "timestofire": -1
                    },

                    {
                        "outputname": "OnHitMin",
				        "targetname": "cannon2_button",
                        "inputname": "Kill",
                        "delay": 77.0,
                        "timestofire": -1
                    },

                    {
                        "outputname": "OnHitMin",
				        "targetname": "cannon3_button",
                        "inputname": "Kill",
                        "delay": 77.0,
                        "timestofire": -1
                    }
				]
			}
		},
        // move the entity
        {
            "match":
            {
                "targetname": "[PR#]escape_platform_temp6",
                "classname": "point_template"
            },
			"insert":
            {
                "template25": "escape_branch"
            }
		}
    ],
    "add":
    [
        {
            "targetname": "music_potal_case",
            "classname": "logic_case",
            "io":
            [
				{
                    "outputname": "OnCase01",
			        "targetname": "client",
                    "inputname": "Command",
                    "overrideparam": "play sounds/music/music_potal1.vsnd",
                    "delay": 0.0,
                    "timestofire": -1
                },

                {
                    "outputname": "OnCase02",
			        "targetname": "client",
                    "inputname": "Command",
                    "overrideparam": "play sounds/music/music_potal2.vsnd",
                    "delay": 0.0,
                    "timestofire": -1
                }
			]
        },

        {
            "targetname": "music_potal1",
            "classname": "point_soundevent",
            "stoponnew": "1",
            "soundname": "music_potal1"
        },

        {
            "targetname": "music_potal2",
            "classname": "point_soundevent",
            "stoponnew": "1",
            "soundname": "music_potal2"
        }
    ]
}        
