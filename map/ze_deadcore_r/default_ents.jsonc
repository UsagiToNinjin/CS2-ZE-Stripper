{
    "modify": // fix the sound volume issue
    [
        {
            "match":
            {
                "targetname": "[PR#]escape_red_relay",
                "classname": "logic_relay"
            },
            "delete":
            {
                "io":
                [
					{
                        "outputname": "OnTrigger",
						"targetname": "[PR#]music_d_red_way2_param",
                        "inputname": "SetFloatValue",
                        "overrideparam": "0",
                        "delay": 0.0,
                        "timestofire": -1
                    }
				]
			},
            "insert":
            {
                "io":
                [
					{
                        "outputname": "OnTrigger",
						"targetname": "music_d_red_way2_param2",
                        "inputname": "SetFloatValue",
                        "overrideparam": "0",
                        "delay": 0.0,
                        "timestofire": -1
                    }
				]
			}
        },

        {
            "match":
            {
                "targetname": "[PR#]music_d_red_way2",
                "classname": "point_soundevent"
            },
            "insert":
            {
                "io":
                [
					{
                        "outputname": "SoundEventGuid",
						"targetname": "music_d_red_way2_param2",
                        "inputname": "SetSoundEventGUID",
                        "delay": 0.0,
                        "timestofire": -1
                    }
				]
			}
        }
    ],
    "add":
    [
        {
            "targetname": "music_d_red_way2_param2",
            "classname": "snd_event_param",
            "parametername": "volume",
            "floatvalue": "1"
        }
    ]
}