                "case07": "7.0",
                "case08": "8.0",
                "case09": "9.0",
                "case10": "10.0",
                "case11": "11.0",
                "case12": "12.0",
                "case13": "13.0",
                "case14": "14.0",
                "case15": "15.0"
			}
		},
        // add fix missing zombie nuke output
        {
            "match":
            {
                "targetname": "[PR#]b_win_detecttrigger",
                "classname": "trigger_once"
